{
  "name": "veriwell-capture",
  "version": "0.1.0",
  "private": false,
  "description": "Open-source browser toolkit for ID document and selfie capture: auto-framing, blur/glare checks, guided face poses with sound and voice cues, and a passport/driving-licence MRZ parser. Runs entirely on the device. Made by Veriwell.",
  "keywords": [
    "camera",
    "document-capture",
    "id-verification",
    "kyc",
    "liveness",
    "mediapipe",
    "face-landmarker",
    "mrz",
    "passport",
    "driving-licence",
    "getusermedia"
  ],
  "homepage": "https://github.com/vestra-corp/veriwell-capture#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vestra-corp/veriwell-capture.git"
  },
  "bugs": {
    "url": "https://github.com/vestra-corp/veriwell-capture/issues"
  },
  "license": "Apache-2.0",
  "author": "Veriwell (https://veriwell.xyz)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "vite examples/vanilla",
    "example:build": "vite build examples/vanilla",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
